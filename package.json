{
  "name": "gha-for-devops",
  "private": true,
  "description": "Local QA tooling for reusable GitHub Actions workflows",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dceoy/gha-for-devops.git"
  },
  "type": "module",
  "scripts": {
    "qa": "bash .agents/skills/local-qa/scripts/qa.sh",
    "format": "oxfmt --write '**/*.{md,mdx,markdown}' '!**/node_modules/**' '!**/.venv/**' --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --check '**/*.{md,mdx,markdown}' '!**/node_modules/**' '!**/.venv/**' --no-error-on-unmatched-pattern",
    "lint": "git ls-files -z -- '*.md' '*.markdown' '*.mdx' | xargs -0 -r markdownlint-cli2",
    "lint:fix": "git ls-files -z -- '*.md' '*.markdown' '*.mdx' | xargs -0 -r markdownlint-cli2 --fix"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "markdownlint-cli": "latest",
    "markdownlint-cli2": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.23.4",
      "onFail": "download"
    }
  }
}
